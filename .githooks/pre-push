#!/usr/bin/env sh
set -eu

if [ "${ALLOW_RELEASE_PUSH:-0}" = "1" ]; then
  exit 0
fi

blocked=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ -z "${remote_ref:-}" ]; then
    continue
  fi

  case "$remote_ref" in
    refs/tags/v*|refs/tags/release-*|refs/heads/release/*)
      echo "Blocked push of release ref: $remote_ref"
      blocked=1
      ;;
  esac
done

if [ "$blocked" -eq 1 ]; then
  echo "Release pushes are blocked by default."
  echo "If intentional, re-run with: ALLOW_RELEASE_PUSH=1 git push ..."
  exit 1
fi
